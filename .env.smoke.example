# Copy this file to .env.smoke.local (gitignored) before running:
#   Copy-Item .env.smoke.example .env.smoke.local
#
# The smoke runner also loads .env.local and .env, so existing Firebase client
# configuration can stay there. Never commit real smoke account passwords.

# Public Firebase Hosting origin. /api/** is rewritten to terroirtrail-api.
SMOKE_PUBLIC_ORIGIN=https://terroir-trail.web.app

# A real producer listing actively owned by SMOKE_HOST_EMAIL.
SMOKE_PRODUCER_ID=

# Two ordinary Traveler-only test accounts.
SMOKE_TRAVELER_A_EMAIL=
SMOKE_TRAVELER_A_PASSWORD=
SMOKE_TRAVELER_B_EMAIL=
SMOKE_TRAVELER_B_PASSWORD=

# A verified Host account that actively owns SMOKE_PRODUCER_ID.
SMOKE_HOST_EMAIL=
SMOKE_HOST_PASSWORD=

# A trusted TerroirTrail Admin account with review moderation authority.
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Optional request timeout in milliseconds.
SMOKE_TIMEOUT_MS=20000

# Required Firebase web-client values. Leave these blank here if they already
# exist in .env.local; .env.smoke.local is loaded first and should not contain
# empty overrides for values you expect to inherit.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
