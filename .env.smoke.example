# Copy this file to .env.smoke.local (gitignored) before running:
#   Copy-Item .env.smoke.example .env.smoke.local
#
# The smoke runner also loads .env.local and .env, so existing Firebase client
# configuration can stay there. Never commit real Host/Admin passwords.

# Public Firebase Hosting origin. /api/** is rewritten to terroirtrail-api.
SMOKE_PUBLIC_ORIGIN=https://terroir-trail.web.app

# Optional. Leave blank to auto-select the first active producer listing owned
# by SMOKE_HOST_EMAIL. If set, it must be owned by that Host account.
SMOKE_PRODUCER_ID=

# A verified Host account with at least one active trusted producer ownership.
SMOKE_HOST_EMAIL=
SMOKE_HOST_PASSWORD=

# A trusted TerroirTrail Admin account with review moderation authority.
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Traveler test accounts are created automatically using unique @example.com
# addresses and random passwords, then permanently deleted after the smoke run.
# No real Traveler inboxes are required.

# Optional request timeout in milliseconds.
SMOKE_TIMEOUT_MS=20000

# Required Firebase web-client values. Leave these commented here if they
# already exist in .env.local.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
