{
  "name": "terroir-trail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "test": "npm run test:frontend && npm run test:server && npm run test:rules",
    "test:frontend": "vitest run src/",
    "test:server": "tsx --test server/tests/*.test.ts && vitest run server/tests/passService.spec.ts server/tests/approveProducerRegistration.spec.ts",
    "test:rules": "tsx scripts/run_rules_tests.ts",
    "preview": "vite preview",
    "deploy": "npm run build && npx -y firebase-tools deploy --only hosting",
    "deploy:firestore": "npx -y firebase-tools deploy --only firestore:rules,firestore:indexes",
    "mobile:preflight": "tsx scripts/mobile_preflight.ts",
    "sync:android": "npm run mobile:preflight -- android && npm run build && npx cap sync android",
    "sync:ios": "npm run mobile:preflight -- ios && npm run build && npx cap sync ios",
    "sync:all": "npm run mobile:preflight -- all && npm run build && npx cap sync",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "stripe:test": "npm test",
    "stripe:flow": "tsx scripts/run_checkout_flow.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.20.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.4.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13"
  }
}
