# Supabase Configuration (Free PostgreSQL + PostGIS Database)
# 1. Create a free project at https://supabase.com
# 2. Run the SQL migration from supabase/migrations/20260908000000_create_terroir_schema.sql
# 3. Copy your project URL and anon public key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Firebase Config (authentication, sync, and producer image storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: CARTO Basemap API Key (Free instant key from https://carto.com/basemaps/apikey)
# Note: If omitted, Terroir Trail automatically uses OpenStreetMap & Esri Topo without any API key or watermarks.
VITE_CARTO_API_KEY=

# Travelpayouts affiliate pilot. Existing tracked tpx.lv links are rendered only when this gate is true.
# Keep false by default for development/test environments; production explicitly enables it.
VITE_ENABLE_TRAVEL_AFFILIATES=false

# Future Google AdSense / display-ad infrastructure (disabled for the current public launch).
# IDs alone never load advertising. Activation requires an explicit product and consent review,
# then setting this strict gate to true together with both IDs.
VITE_ENABLE_ADVERTISING=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

# Stripe API Keys (Obtain from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Explorer Pass API (server-only settings; never prefix secrets with VITE_)
# Fixed one-time EUR prices: holiday = 1499 cents, annual = 2999 cents.
STRIPE_HOLIDAY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Producer Partner Billing (server-only; separate from Explorer Pass)
# Checkout stays disabled unless BOTH the strict gate and a valid recurring annual Price ID are present.
# Keep false in development and production until the Stripe product/price and webhook lifecycle are verified.
STRIPE_PARTNER_BILLING_ENABLED=false
STRIPE_PARTNER_ANNUAL_PRICE_ID=
# Failed renewal keeps paid entitlement for this bounded recovery window (1-30 days; default 7).
PARTNER_BILLING_GRACE_DAYS=7
FIREBASE_PROJECT_ID=
# Use application default credentials on your server, or a credential file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Set to the HTTPS API origin for hosted web/native builds; blank uses the Vite dev proxy.
VITE_API_BASE_URL=
VITE_PUBLIC_APP_URL=https://terroir-trail.web.app

# Trip Intelligence routing (server-only)
# Mapbox Matrix API token used by Phase 15.8B Optimize My Day.
# Never prefix with VITE_ or expose this token to the browser bundle.
MAPBOX_ACCESS_TOKEN=

# Transactional email (server-only)
# TerroirTrail uses Gmail SMTP for account welcome and producer approval notifications.
# Store TERROIRTRAIL_EMAIL_APP_PASSWORD in Secret Manager / Cloud Run; never commit the real value.
# Google App Passwords require 2-Step Verification on the sender account.
TERROIRTRAIL_EMAIL_USER=terroirtrail@gmail.com
TERROIRTRAIL_EMAIL_APP_PASSWORD=

# Server-only Analytics & Database Ingestion
# Cloud Run needs the project URL at runtime. It is not secret, but keep the server
# configuration independent of the browser build-time VITE_ environment.
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is required for trusted server-side ingestion into public.ingest_intent_event_v1.
# NEVER prefix with VITE_ or expose to client builds.
SUPABASE_SERVICE_ROLE_KEY=
# ANALYTICS_HMAC_SECRET is used to derive privacy-preserving pseudonyms for actor_key and session_key.
# Provide a cryptographically random secret of at least 32 characters.
ANALYTICS_HMAC_SECRET=

# Legacy Host Pro payment link (Explorer passes use authenticated API checkout).
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PRODUCER_UPGRADE_URL=

# Feature flags for dormant Explorer Pass checkout.
# BOTH layers must be deliberately enabled before purchases can resume:
# - browser UI gate
# - server checkout authority gate
VITE_ENABLE_EXPLORER_PASS_PURCHASES=false
EXPLORER_PASS_CHECKOUT_ENABLED=false

# Google Maps Platform (Optional: Places UI Kit Essentials prototype for producer media)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials.
# Restrict this browser/WebView key to the origins that actually load Maps JS:
#   https://terroir-trail.web.app/* (hosted production)
#   https://localhost/*              (Capacitor Android WebView)
#   http://localhost:5173/*          (Vite development)
#
# API restrictions must include Maps JavaScript API because the app loads
# https://maps.googleapis.com/maps/api/js and imports the Places library.
# Places API (New) must also be enabled for the modern Place/photos flow.
# Do not use an Android-app-restricted key here: this is a browser/WebView key.
VITE_GOOGLE_MAPS_API_KEY=

# Google Places Media Prototype Feature Flag (Experimental / pre-GA; defaults to false)
# Set to true only in environments where Google Places UI Kit media is actively being tested.
# Google Places UI Kit initializes ONLY when BOTH VITE_ENABLE_GOOGLE_PLACES_MEDIA=true
# AND a valid VITE_GOOGLE_MAPS_API_KEY is configured.
VITE_ENABLE_GOOGLE_PLACES_MEDIA=false

# Durable producer image uploads. Production enables this in .env.production.
# Requires Firebase Storage and VITE_FIREBASE_STORAGE_BUCKET. Storage rules restrict
# writes/deletes to the verified active owner in producer_owners.
VITE_ENABLE_HOST_MEDIA_UPLOADS=false

# Legacy Host Media Blob Prototype (development-only; defaults to false)
# Keep false in production. This controls only historical temporary browser blob URLs;
# it is intentionally separate from the durable Firebase Storage upload feature above.
VITE_ENABLE_HOST_MEDIA_PROTOTYPE=false
