# Supabase Configuration (Free PostgreSQL + PostGIS Database)
# 1. Create a free project at https://supabase.com
# 2. Run the SQL migration from supabase/migrations/20260908000000_create_terroir_schema.sql
# 3. Copy your project URL and anon public key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Firebase Config (Fallback sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: CARTO Basemap API Key (Free instant key from https://carto.com/basemaps/apikey)
# Note: If omitted, Terroir Trail automatically uses OpenStreetMap & Esri Topo without any API key or watermarks.
VITE_CARTO_API_KEY=

# Optional: Google AdSense / Display Ad Monetization
# 1. Register your site domain at https://adsense.google.com
# 2. Copy your publisher client ID (e.g., ca-pub-1234567890123456) and display ad slot ID
# Note: If omitted, Terroir Trail automatically displays our built-in curated agritourism sponsor banners.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

# Stripe API Keys (Obtain from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Explorer Pass API (server-only settings; never prefix secrets with VITE_)
# Fixed one-time EUR prices: holiday = 1499 cents, annual = 2999 cents.
STRIPE_HOLIDAY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
FIREBASE_PROJECT_ID=
# Use application default credentials on your server, or a credential file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Set to the HTTPS API origin for hosted web/native builds; blank uses the Vite dev proxy.
VITE_API_BASE_URL=
VITE_PUBLIC_APP_URL=https://terroir-trail.web.app

# Legacy Host Pro payment link (Explorer passes use authenticated API checkout).
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PRODUCER_UPGRADE_URL=

