# Launch feature controls safe to expose in the client bundle.
# Producer media files are persisted in Firebase Storage; authorization remains
# enforced by Firebase Storage Rules and the trusted producer_owners mapping.
VITE_ENABLE_HOST_MEDIA_UPLOADS=true

# Google Places producer media is enabled for audited records only. The client
# still requires VITE_GOOGLE_MAPS_API_KEY at build time and fails closed without it.
VITE_ENABLE_GOOGLE_PLACES_MEDIA=true

# Travelpayouts affiliate pilot. This uses existing tracked tpx.lv links and
# explicit per-placement SubIDs; no Travelpayouts API token is exposed client-side.
VITE_ENABLE_TRAVEL_AFFILIATES=true
