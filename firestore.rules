rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Traveler Passport & Notes
    // Users can strictly ONLY read and write their own stamps and notes
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Tasting Reservations
    // Any traveler can submit a booking request
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.email == resource.data.userEmail
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // 3. Producer Overrides (Special hours, closures)
    // Publicly readable for all travelers; only authenticated users can edit
    match /producer_overrides/{producerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
