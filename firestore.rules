rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProducerOwner(producerId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/producer_owners/$(producerId))
        && get(/databases/$(database)/documents/producer_owners/$(producerId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/producer_owners/$(producerId)).data.status == 'active';
    }

    // 1. Traveler Passport & Profile
    // Users can strictly read their own profile.
    // Ordinary traveler profile fields are writable, but all authorization and role fields are blocked.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'role',
          'isProducer',
          'claimedProducerId',
          'producerName',
          'claimStatus',
          'taxDetails',
          'hasExplorerPass',
          'explorerPassUntil',
          'explorerPassId',
          'explorerPassPlan'
        ]);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isProducer',
          'claimedProducerId',
          'producerName',
          'claimStatus',
          'taxDetails',
          'hasExplorerPass',
          'explorerPassUntil',
          'explorerPassId',
          'explorerPassPlan'
        ]);

      allow delete: if false;
    }

    // 2. Trusted Producer Ownership (producerId <-> ownerUid mapping)
    // Only Admin SDK code may write ownership records.
    // Verified owners can read their own ownership records.
    match /producer_owners/{producerId} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // 3. Producer Registrations & Claims
    // Authenticated applicants submit claims in pending_verification status with isVatVerified = false.
    // Applicants can read/edit their submission but cannot modify protected verification/approval fields.
    // Verified owners can view/update operational details while protected fields stay immutable.
    match /producer_registrations/{producerId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isProducerOwner(producerId)
      );

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.producerId == producerId
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.isVatVerified == false
        && !('approvedAt' in request.resource.data)
        && !('approvedBy' in request.resource.data);

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isProducerOwner(producerId)
      )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.producerId == resource.data.producerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.isVatVerified == resource.data.isVatVerified
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'producerId',
          'status',
          'isVatVerified',
          'approvedAt',
          'approvedBy'
        ]);

      allow delete: if false;
    }

    // 4. Producer Overrides (Special hours, notices, booking pause)
    // Publicly readable for all travelers.
    // Writable only by verified active owner from producer_owners.
    // Requires document ID == embedded producerId. Client cannot set or mutate isProTier.
    match /producer_overrides/{producerId} {
      allow read: if true;

      allow create: if isProducerOwner(producerId)
        && request.resource.data.producerId == producerId
        && !('isProTier' in request.resource.data);

      allow update: if isProducerOwner(producerId)
        && request.resource.data.producerId == producerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isProTier']);

      allow delete: if false;
    }

    // 5. Tasting Reservations / Bookings
    // Strict allow-list validation on create and lifecycle updates.
    match /bookings/{bookingId} {
      function isValidNewBooking() {
        let d = request.resource.data;
        return d.keys().hasAll([
            'id', 'producerId', 'producerName', 'producerCategory', 'producerLocation',
            'userId', 'userName', 'userEmail', 'userPhone', 'date', 'timeSlot',
            'experienceId', 'experienceTitle', 'pricePerPerson', 'guestsCount',
            'totalEstimated', 'status', 'createdAt'
          ])
          && d.keys().hasOnly([
            'id', 'producerId', 'producerName', 'producerCategory', 'producerLocation',
            'userId', 'userName', 'userEmail', 'userPhone', 'date', 'timeSlot',
            'experienceId', 'experienceTitle', 'pricePerPerson', 'guestsCount',
            'totalEstimated', 'status', 'createdAt', 'specialRequests'
          ])
          && d.id == bookingId
          && d.userId == request.auth.uid
          && d.status == 'pending'
          && d.id is string
          && d.producerId is string
          && d.producerName is string
          && d.producerCategory is string
          && d.producerLocation is string
          && d.userName is string
          && d.userEmail is string
          && d.userPhone is string
          && d.date is string
          && d.timeSlot is string
          && d.experienceId is string
          && d.experienceTitle is string
          && d.pricePerPerson is number
          && d.guestsCount is number && d.guestsCount > 0
          && d.totalEstimated is number
          && d.createdAt is string
          && (!('specialRequests' in d) || d.specialRequests is string);
      }

      function isValidTravelerCancellation() {
        return resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      function isValidHostLifecycleUpdate() {
        let diff = request.resource.data.diff(resource.data);
        return isProducerOwner(resource.data.producerId)
          && (
            (
              resource.data.status == 'pending'
              && (
                (request.resource.data.status == 'confirmed' && diff.affectedKeys().hasOnly(['status', 'confirmedAt']) && request.resource.data.confirmedAt is string)
                ||
                (request.resource.data.status == 'cancelled' && diff.affectedKeys().hasOnly(['status']))
              )
            )
            ||
            (
              resource.data.status == 'confirmed'
              && diff.affectedKeys().hasOnly(['status'])
              && (request.resource.data.status == 'completed' || request.resource.data.status == 'cancelled')
            )
          );
      }

      // Authenticated traveler can create a pending booking for themselves
      allow create: if isAuthenticated() && isValidNewBooking();

      // Traveler reads own bookings; Host reads bookings for owned producer
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isProducerOwner(resource.data.producerId)
      );

      // Status updates:
      // - Traveler may only transition pending -> cancelled (affectedKeys must be ONLY status)
      // - Approved host may transition pending -> confirmed (with confirmedAt) or cancelled,
      //   and confirmed -> completed or cancelled (affectedKeys must be ONLY status)
      // All other fields remain strictly immutable.
      allow update: if isAuthenticated() && (
        isValidTravelerCancellation() || isValidHostLifecycleUpdate()
      );

      // Deletion is denied; cancellation is the implemented workflow
      allow delete: if false;
    }

    // 6. Paid Explorer Passes (Issue #1 Protection)
    // Paid entitlements are private and are issued/read only through the Admin SDK API.
    match /explorerPasses/{sessionId} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
